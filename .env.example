APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Dozvon Bot ---
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=DozvonRfRbKz_Bot
TELEGRAM_LOG_CHANNEL=null

ZVONOK_DRIVER=fake
ZVONOK_BASE_URL=https://zvonok.com/manager/cabapi_external/api/v1
ZVONOK_RATE_LIMIT=20
ZVONOK_POSTBACK_SECRET=
ZVONOK_DEFAULT_GEO=RU

# Аккаунты Звонок.com по странам (public_key + campaign_id на каждую страну)
ZVONOK_RU_API_KEY=
ZVONOK_RU_CAMPAIGN_ID=
ZVONOK_BY_API_KEY=
ZVONOK_BY_CAMPAIGN_ID=
ZVONOK_KZ_API_KEY=
ZVONOK_KZ_CAMPAIGN_ID=

# legacy-пара (общий фолбэк, если у страны нет своего аккаунта)
ZVONOK_API_KEY=
ZVONOK_CAMPAIGN_ID=

USDT_WALLET=
USDT_CONFIRMATIONS=19
USDT_PROVIDER=manual
TRONSCAN_API_KEY=

ADMIN_EMAIL=admin@dozvon.local
ADMIN_PASSWORD=password

# --- Продакшн-конфиг бота (читается сидерами при установке) ---
ADMIN_IDS=            # Telegram-ID админов через запятую
MANAGER_URL=          # ссылка на менеджера (оплата/поддержка), напр. https://t.me/prozvonok_cat
CHANNEL_URL=          # ссылка на канал, напр. https://t.me/prozvonoksng
REQUIRED_CHANNEL=     # @username канала обязательной подписки (бот должен быть его админом)
DB_ROOT_PASSWORD=rootsecret
