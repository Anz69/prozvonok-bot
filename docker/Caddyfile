# Caddy — авто-HTTPS через Let's Encrypt (домен смотрит прямо на сервер, без Cloudflare).
# Порты 80 и 443 должны быть открыты и доступны из интернета (ACME HTTP-01 challenge).
# APP_DOMAIN=radistka.pro. Локально без домена — localhost (self-signed автоматически).
{
	email {$ACME_EMAIL:admin@radistka.pro}
}

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	# крупные загрузки баз номеров
	request_body {
		max_size 25MB
	}

	reverse_proxy nginx:80
}
